<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="doubao_secure_settings.xml"/>
        <exclude domain="database" path="doubao_chat_db"/>
        <exclude domain="database" path="doubao_chat_db-shm"/>
        <exclude domain="database" path="doubao_chat_db-wal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="doubao_secure_settings.xml"/>
        <exclude domain="database" path="doubao_chat_db"/>
        <exclude domain="database" path="doubao_chat_db-shm"/>
        <exclude domain="database" path="doubao_chat_db-wal"/>
    </device-transfer>
</data-extraction-rules>